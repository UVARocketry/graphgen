{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "graph",
      "camelcase": "Graph",
      "scope": "source.graph",
      "path": ".",
      "file-types": [
        "graph"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "injection-regex": "^graph$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the .graph data definition language",
    "authors": [
      {
        "name": "christopher-wood"
      }
    ]
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false,
    "kotlin": false,
    "zig": false
  }
}
